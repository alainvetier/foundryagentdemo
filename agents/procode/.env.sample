# Generated by scripts/deploy.sh - or fill in manually.
FOUNDRY_PROJECT_ENDPOINT=https://<foundry-account>.services.ai.azure.com/api/projects/whisker-works
APIM_GATEWAY_URL=https://<apim-name>.azure-api.net
APIM_MODELS_PATH=models
APIM_STORE_PATH=store
APIM_MCP_PATH=whisker-mcp
# Name of the Foundry project connection holding the APIM key (preferred, see docs/11)
MCP_PROJECT_CONNECTION_NAME=
# Fallback only if no project connection: APIM subscription key (Gold)
APIM_SUBSCRIPTION_KEY=
# Used by scripts/test-gateway.py and scripts/test-a2a.py
APIM_BRONZE_KEY=
APIM_GOLD_KEY=
CHAT_MODEL=gpt-4.1-mini
NEW_MODEL=gpt-5-mini
# Used by create-mcp-servers.sh / cleanup scripts
AZURE_SUBSCRIPTION_ID=
RG=rg-whisker-works
APIM_NAME=<apim-name>
APIM_RG=<apim-resource-group>
